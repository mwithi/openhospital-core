<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.isf</groupId>
  <artifactId>plugin-maven-plugin</artifactId>
  <version>1.0.0</version>
  <packaging>maven-plugin</packaging>

  <name>OH Plugin Maven Plugin</name>
  <description>
    Maven plugin for Open Hospital plugin development.
    Provides the generate-manifest goal, which instantiates the OHPlugin
    class via reflection, calls getDescriptor(), and writes manifest.json
    into target/classes/ so it is included in the final JAR automatically.
  </description>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.version>3.9.9</maven.version>
    <spi.version>1.0.0</spi.version>
  </properties>

  <dependencies>

    <!-- Maven plugin API -->
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Annotations for @Mojo, @Parameter etc. -->
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>3.15.1</version>
      <scope>provided</scope>
    </dependency>

    <!-- Access to the project being built (classpath, source dirs etc.) -->
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- The SPI — needed to load OHPlugin and call getDescriptor() -->
    <dependency>
      <groupId>org.isf</groupId>
      <artifactId>OH-plugin-spi</artifactId>
      <version>${spi.version}</version>
    </dependency>

    <!-- Jackson for pretty-printed manifest.json serialization -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.18.2</version>
    </dependency>

    <!-- SLF4J — transitive from SPI, already available -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.13</version>
    </dependency>

  </dependencies>

  <build>
    <plugins>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>17</release>
        </configuration>
      </plugin>

      <!--
        Generates the plugin descriptor (META-INF/maven/plugin.xml)
        from the @Mojo and @Parameter annotations. Required for Maven
        to recognise the plugin and its goals.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>3.15.1</version>
        <executions>
          <execution>
            <id>default-descriptor</id>
            <goals><goal>descriptor</goal></goals>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

</project>
